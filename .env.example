# Login da aplicação (membro de app_user, sem BYPASSRLS). Em dev: pnpm db:dev-login
DATABASE_URL=postgres://app_login:app_login@localhost:5432/restaurante
# Papel dono das tabelas, usado só para migrar.
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/restaurante
BETTER_AUTH_SECRET=troque-por-um-segredo-longo
BETTER_AUTH_URL=http://localhost:3000
# memory (desenvolvimento), file (testes ponta a ponta, grava em MAIL_DIR) ou resend (produção)
MAILER=memory
MAIL_DIR=.mail
RESEND_API_KEY=
MAIL_FROM="Sistema Restaurante <nao-responda@exemplo.com.br>"
# Testes de integração: se definido, usa este PostgreSQL em vez de subir um container.
TEST_DATABASE_URL=
