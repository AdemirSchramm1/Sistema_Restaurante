{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.stryker.config.mts" },
  "mutate": [
    "src/domain/menu/**/*.ts",
    "!src/domain/menu/**/*.test.ts",
    "src/domain/cash/**/*.ts",
    "!src/domain/cash/**/*.test.ts",
    "src/domain/ordering/kitchen-note.ts",
    "src/domain/ordering/staff-request.ts",
    "src/domain/ordering/reorder.ts",
    "src/domain/ordering/similar-orders.ts",
    "src/domain/ordering/menu-access.ts",
    "src/domain/ordering/tablet-screen.ts",
    "src/domain/ordering/tablet-signal.ts",
    "src/domain/ordering/quick-add.ts"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "reporters": ["clear-text", "progress"],
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": [
    ".next",
    "coverage",
    "test-results",
    "tests/screens/__screenshots__",
    ".menu-photos",
    ".mail"
  ]
}
